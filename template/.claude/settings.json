{
  "permissions": {
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.dev.vars.local)",
      "Read(./.dev.vars.development)",
      "Read(./.dev.vars.staging)",
      "Read(./.dev.vars.production)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Edit(./.dev.vars)",
      "Edit(./.dev.vars.local)",
      "Edit(./.dev.vars.development)",
      "Edit(./.dev.vars.staging)",
      "Edit(./.dev.vars.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.staging)",
      "Edit(./.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-secrets.py",
            "onFailure": "block",
            "statusMessage": "シークレットファイルへのアクセスを確認中"
          }
        ]
      }
    ]
  }
}
